server {
    listen       80;
    server_name  localhost;
    return 301 https://$host:3443$request_uri;
}

server {
    listen       443 ssl;
    server_name  localhost;

    # Docker embedded DNS — nginx резолвит upstream'ы динамически (на каждый запрос,
    # с кэшем 10с). Без этого при пересоздании backend-контейнера (новый IP в asop-net)
    # nginx держал бы закэшированный старый IP → connect() refused → 502.
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate     /certs/web-admin.crt;
    ssl_certificate_key /certs/web-admin.key;

    root   /usr/share/nginx/html;
    index  index.html;

    location /api/ {
        set $gateway_upstream gateway-service:8080;
        proxy_pass https://$gateway_upstream;
        proxy_ssl_verify off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /realms/ {
        set $gateway_upstream gateway-service:8080;
        proxy_pass https://$gateway_upstream;
        proxy_ssl_verify off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /resources/ {
        set $keycloak_upstream keycloak:8443;
        proxy_pass https://$keycloak_upstream;
        proxy_ssl_verify off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All traffic HTTPS, trust system + user CAs for dev -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
